# Дропшиппинг магазин — конфигурация
# Скопируйте в .env и заполните свои значения

# База данных
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shop_db

# Telegram бот
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=455255915

# XML фиды от dropshipping.ua
XML_FEED_URLS=https://api.dropshipping.ua/api/feeds/3411.xml,https://api.dropshipping.ua/api/feeds/3410.xml,https://api.dropshipping.ua/api/feeds/3412.xml,https://api.dropshipping.ua/api/feeds/3413.xml

# Наценка в % (например 30 = +30% к цене поставщика)
PRICE_MARKUP=30

# Обновление товаров (каждые N часов)
SYNC_INTERVAL_HOURS=6

# Сайт
NEXT_PUBLIC_API_URL=http://localhost:8000
SITE_URL=https://yoursite.com.ua
